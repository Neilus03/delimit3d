__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
venv/
.env
*.egg-info/
build/
dist/

# Never put private data, checkpoints, or generated run output in Git.
*.pt
*.pth
*.ckpt
*.safetensors
*.npy
*.npz
*.ply
*.png
*.jpg
*.jpeg
*.pdf
*.svg
*.csv
*.jsonl
*.log
*.out
*.err
runs/
features/
exports/
reports/generated/

# Keep small, hand-authored manifests and examples versioned.
!manifests/*.json
!configs/**/*.json
!tests/fixtures/**/*.json
