# Runtime identity. Change only this value to rename report labels and default
# artifact directories without editing the Python package.
DELIMIT3D_NAME=Delimit3D

# External roots. These contain data, checkpoints, environments, and run output;
# they are deliberately outside the Git repository.
DELIMIT3D_WORK_ROOT=/cluster/work/igp_psr/nedela
DELIMIT3D_ARTIFACT_ROOT=/cluster/work/igp_psr/nedela/delimit3d
DELIMIT3D_STRUCTURED3D_ROOT=/cluster/work/igp_psr/nedela/structured3d_raw
DELIMIT3D_SCANNET_ROOT=/cluster/work/igp_psr/nedela/scannet_raw
DELIMIT3D_SCANNETPP_ROOT=/cluster/work/igp_psr/nedela/scannetpp_data
DELIMIT3D_LITEPT_ROOT=/cluster/work/igp_psr/nedela/LitePT
DELIMIT3D_UNSAM_ROOT=/cluster/work/igp_psr/nedela/UnSAMv2

# Optional runtime overrides.
# DELIMIT3D_DEVICE=cuda
# DELIMIT3D_SCANNET_PAIR_ROOT=/path/to/scannet_pair
# DELIMIT3D_SCANNET_METADATA_ROOT=/path/to/LitePT/datasets/preprocessing/scannet/meta_data
# DELIMIT3D_SCANNET_EVAL_BENCHMARK=scannet20
# UNSAM_ROOT=$DELIMIT3D_UNSAM_ROOT
# UNSAMV2_CKPT=$DELIMIT3D_UNSAM_ROOT/sam2/checkpoints/unsamv2/unsamv2_plus_ckpt.pt

# Sonata short adaptation (public encoder source/checkpoint are external and
# kept outside Git; the source root must contain Delimit3D source_manifest.json
# files, not raw Structured3D archives).
export DELIMIT3D_STRUCTURED3D_SOURCE_ROOT=/cluster/work/igp_psr/nedela/partfield_contrastive_gt3_unsam3_scratch/structured3d_sources_raw_unsamv2_90val
export DELIMIT3D_STRUCTURED3D_TRAIN_SPLIT=/cluster/work/igp_psr/nedela/partfield_contrastive_gt3_unsam3_scratch/structured3d_splits/train.txt
export DELIMIT3D_SONATA_ROOT=/cluster/work/igp_psr/nedela/sonata
export DELIMIT3D_SONATA_CHECKPOINT=/cluster/work/igp_psr/nedela/sonata_weights/sonata.pth
